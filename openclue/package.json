{
  "name": "openclue",
  "productName": "OpenClue",
  "version": "0.1.0",
  "description": "A transparent, local-first AI desktop assistant overlay for macOS. Ollama + Whisper, no account required.",
  "main": "./out/main/index.js",
  "author": "OpenClue contributors",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:unsigned": "npm run build && electron-builder --mac -c.mac.identity=null",
    "dist:dir": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.72.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
